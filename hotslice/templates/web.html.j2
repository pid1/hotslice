<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>hotslice - Markdown to Slides</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0d1117;
      --fg: #e6edf3;
      --accent: #58a6ff;
      --surface: #161b22;
      --border: #30363d;
      --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    }
    html, body { height: 100%; font-family: var(--font-sans); background: var(--bg); color: var(--fg); }
    body { display: flex; align-items: center; justify-content: center; padding: 2rem; }
    .container { max-width: 520px; width: 100%; }
    h1 { font-size: 2rem; margin-bottom: 0.25rem; }
    h1 span { color: var(--accent); }
    .subtitle { color: #8b949e; margin-bottom: 2rem; font-size: 1rem; }
    form { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; }
    label { display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem; color: #8b949e; }
    .field { margin-bottom: 1.5rem; }
    input[type="file"], select {
      width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border);
      background: var(--bg); color: var(--fg); font-family: var(--font-sans); font-size: 0.95rem;
    }
    select option { background: var(--bg); color: var(--fg); }
    button {
      width: 100%; padding: 0.85rem; border: none; border-radius: 8px;
      background: var(--accent); color: #0d1117; font-size: 1rem; font-weight: 600;
      cursor: pointer; transition: opacity 0.15s;
    }
    button:hover { opacity: 0.9; }
    .footer { text-align: center; margin-top: 1.5rem; font-size: 0.8rem; color: #484f58; }
    .footer a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <h1><span>hotslice</span></h1>
    <p class="subtitle">Upload a Markdown file. Download a presentation.</p>
    <form action="/convert" method="post" enctype="multipart/form-data">
      <div class="field">
        <label for="file">Markdown file</label>
        <input type="file" id="file" name="file" accept=".md,.markdown,.txt" required>
      </div>
      <div class="field">
        <label for="theme">Theme</label>
        <select id="theme" name="theme">
          {% for t in themes %}
          <option value="{{ t.name }}"{% if t.name == "light" %} selected{% endif %}>{{ t.name }}{% if t.description %} - {{ t.description }}{% endif %}</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit">Build &amp; Download</button>
    </form>
    <div class="footer">Powered by <a href="https://github.com/pid1/hotslice">hotslice</a></div>
  </div>
</body>
</html>
