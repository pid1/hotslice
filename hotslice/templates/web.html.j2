<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>hotslice - Markdown to Slides</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#x1F355;</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Fredoka:wght@400;500;600;700&family=Comic+Neue:wght@400;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #FFF8F0;
      --fg: #3D2B1F;
      --primary: #E63946;
      --secondary: #F4A261;
      --surface: #FFFDF7;
      --accent-bg: #FDEBD0;
      --font-display: 'Fredoka', sans-serif;
      --font-body: 'Comic Neue', cursive, sans-serif;
    }

    html, body {
      height: 100%;
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--fg);
    }

    body {
      position: relative;
      overflow-x: hidden;
      min-height: 100vh;
      /* Checkered tablecloth pattern */
      background-image:
        linear-gradient(45deg, rgba(230, 57, 70, 0.04) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(230, 57, 70, 0.04) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgba(230, 57, 70, 0.04) 75%),
        linear-gradient(-45deg, transparent 75%, rgba(230, 57, 70, 0.04) 75%);
      background-size: 40px 40px;
      background-position: 0 0, 0 20px, 20px -20px, -20px 0px;
    }

    /* Floating pizza decorations */
    .floating-pizza {
      position: fixed;
      font-size: 2rem;
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
      animation: floatPizza 6s ease-in-out infinite;
    }
    .floating-pizza:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; font-size: 2.5rem; }
    .floating-pizza:nth-child(2) { top: 30%; right: 8%; animation-delay: 1.5s; font-size: 1.8rem; }
    .floating-pizza:nth-child(3) { bottom: 20%; left: 10%; animation-delay: 3s; font-size: 2.2rem; }
    .floating-pizza:nth-child(4) { bottom: 10%; right: 12%; animation-delay: 4.5s; font-size: 1.5rem; }
    .floating-pizza:nth-child(5) { top: 60%; left: 3%; animation-delay: 2s; font-size: 1.6rem; }

    @keyframes floatPizza {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(10deg); }
    }

    /* Header */
    .header {
      text-align: center;
      padding: 40px 20px 20px;
      position: relative;
      z-index: 1;
    }
    .header h1 {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 700;
      color: var(--primary);
      text-shadow: 3px 3px 0px rgba(244, 162, 97, 0.3);
      margin-bottom: 0.25rem;
    }
    .header .subtitle {
      font-family: var(--font-body);
      color: #8B7355;
      font-size: 1.1rem;
    }

    /* Main two-column layout */
    .main-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 900px) {
      .main-content {
        grid-template-columns: 1fr;
      }
    }

    /* Form card */
    .form-card {
      background: var(--surface);
      border: 3px solid var(--secondary);
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 6px 6px 0px var(--secondary);
    }
    .form-card h2 {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: var(--primary);
      margin-bottom: 1.5rem;
    }

    /* Field groups */
    .field {
      margin-bottom: 1.5rem;
    }
    .field label {
      display: block;
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 0.9rem;
      color: #6B5B4F;
      margin-bottom: 0.5rem;
    }

    /* File input styled as button */
    .file-input-wrapper {
      position: relative;
    }
    .file-input-wrapper input[type="file"] {
      position: absolute;
      width: 0;
      height: 0;
      opacity: 0;
      overflow: hidden;
    }
    .file-label {
      display: block;
      width: 100%;
      padding: 14px 25px;
      background: var(--primary);
      color: #fff;
      text-align: center;
      border-radius: 30px;
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      border: 3px solid #C0392B;
      box-shadow: 3px 3px 0px #C0392B;
      letter-spacing: 0.5px;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .file-label:hover {
      background: #C0392B;
      transform: scale(1.05) rotate(-0.5deg);
      box-shadow: 4px 5px 0px #962D22;
    }

    /* Theme search */
    .theme-search {
      width: 100%;
      padding: 10px 16px;
      border-radius: 12px 12px 0 0;
      border: 3px solid var(--secondary);
      border-bottom: none;
      background: var(--surface);
      color: var(--fg);
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 500;
      box-shadow: 3px 0 0px var(--secondary);
    }
    .theme-search:focus {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Theme select */
    .theme-select {
      width: 100%;
      padding: 12px 16px;
      border-radius: 0 0 12px 12px;
      border: 3px solid var(--secondary);
      background: var(--surface);
      color: var(--fg);
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 500;
      box-shadow: 3px 3px 0px var(--secondary);
      appearance: auto;
    }
    .theme-select:focus {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Build button */
    .build-btn {
      display: block;
      width: 100%;
      padding: 14px 25px;
      background: var(--primary);
      color: #fff;
      text-align: center;
      border-radius: 30px;
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      border: 3px solid #C0392B;
      box-shadow: 3px 3px 0px #C0392B;
      letter-spacing: 0.5px;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .build-btn:hover {
      background: #C0392B;
      transform: scale(1.05) rotate(-0.5deg);
      box-shadow: 4px 5px 0px #962D22;
    }

    /* Preview panel */
    .preview-panel {
      position: relative;
    }
    .preview-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: var(--primary);
      margin-bottom: 1rem;
    }
    .preview-frame {
      background: var(--surface);
      border: 3px solid var(--secondary);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 6px 6px 0px var(--secondary);
      aspect-ratio: 16 / 10;
    }
    .preview-slide {
      height: 100%;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    .preview-inner {
      overflow: hidden;
    }
    .preview-inner h2 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      margin-bottom: 0.4em;
    }
    .preview-inner p {
      font-size: 0.75rem;
      line-height: 1.5;
      margin-bottom: 0.5em;
    }
    .preview-inner ul {
      font-size: 0.75rem;
      line-height: 1.5;
      margin-left: 1.2em;
      margin-bottom: 0.5em;
    }
    .preview-inner li {
      margin-bottom: 0.15em;
    }
    .preview-inner pre {
      padding: 0.6em 0.8em;
      margin: 0.4em 0;
      overflow: hidden;
    }
    .preview-inner pre code {
      font-size: 0.65rem;
      line-height: 1.4;
      font-family: 'Atkinson Hyperlegible Mono', monospace;
    }

    /* Dynamic preview accent (for elements that cannot use inline styles) */
    .preview-slide { --preview-accent: #E63946; }
    .preview-slide li::marker { color: var(--preview-accent); }
    .preview-slide a { color: var(--preview-accent); }

    /* Footer */
    .footer {
      text-align: center;
      padding: 20px;
      font-family: var(--font-display);
      color: #8B7355;
      font-size: 0.85rem;
      position: relative;
      z-index: 1;
    }
    .footer a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }
    .footer a:hover {
      text-decoration: underline;
    }

    .header .description {
      font-family: var(--font-body);
      color: #6B5B4F;
      font-size: 0.95rem;
      max-width: 680px;
      margin: 0.75rem auto 0;
      line-height: 1.6;
    }

    .info-section {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px 20px 20px;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 900px) {
      .info-section {
        grid-template-columns: 1fr;
      }
    }
    .info-card {
      background: var(--surface);
      border: 3px solid var(--secondary);
      border-radius: 20px;
      padding: 1.5rem;
      box-shadow: 6px 6px 0px var(--secondary);
    }
    .info-card h3 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--primary);
      margin-bottom: 0.75rem;
    }
    .info-card p {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--fg);
      margin-bottom: 0.5rem;
    }
    .info-card code {
      font-family: 'Atkinson Hyperlegible Mono', monospace;
      font-size: 0.75rem;
      background: var(--accent-bg);
      padding: 2px 6px;
      border-radius: 4px;
    }
    .info-card pre {
      background: var(--accent-bg);
      border: 2px solid var(--secondary);
      border-radius: 10px;
      padding: 0.75rem;
      margin-top: 0.5rem;
      overflow-x: auto;
    }
    .info-card pre code {
      background: none;
      padding: 0;
      font-size: 0.7rem;
      line-height: 1.5;
      color: var(--fg);
    }

    .footer .sponsor {
      margin-bottom: 12px;
    }
    .sponsor-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--surface);
      border: 2px solid var(--secondary);
      border-radius: 30px;
      color: var(--primary);
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 3px 3px 0px var(--secondary);
      transition: all 0.2s ease;
    }
    .sponsor-link:hover {
      background: var(--primary);
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 4px 5px 0px var(--secondary);
      text-decoration: none;
    }
  </style>
</head>
<body>
  <!-- Floating pizza decorations -->
  <div class="floating-pizza">&#127829;</div>
  <div class="floating-pizza">&#127830;</div>
  <div class="floating-pizza">&#127829;</div>
  <div class="floating-pizza">&#127830;</div>
  <div class="floating-pizza">&#127829;</div>

  <div class="header">
    <h1>&#127829; hotslice</h1>
    <p class="subtitle">Upload a Markdown file. Download a presentation.</p>
    <p class="description">hotslice converts Markdown into self-contained HTML slide decks with keyboard navigation, syntax highlighting, and 257 themes. Use the CLI, this web UI, or connect an AI agent via the MCP server.</p>
  </div>

  <div class="main-content">
    <!-- Left column: form -->
    <div class="form-card">
      <h2>Build Your Deck</h2>
      <form action="/convert" method="post" enctype="multipart/form-data">
        <div class="field">
          <label for="file">Markdown File</label>
          <div class="file-input-wrapper">
            <input type="file" id="file" name="file" accept=".md,.markdown,.txt" required>
            <label for="file" class="file-label" id="file-label">
              <span id="file-label-text">Choose a file...</span>
            </label>
          </div>
        </div>
        <div class="field">
          <label for="theme">Theme</label>
          <input type="text" id="theme-search" class="theme-search" placeholder="Search themes..." autocomplete="off">
          <select id="theme" name="theme" class="theme-select" size="8">
            <optgroup label="Light Themes">
              {% for t in themes if t.variant == "light" %}
              <option value="{{ t.name }}"
                      data-variant="{{ t.variant }}"
                      data-hljs-theme="{{ t.hljs_theme }}"
                      data-slide-bg="{{ t.colors.slide_bg }}"
                      data-slide-fg="{{ t.colors.slide_fg }}"
                      data-accent="{{ t.colors.accent }}"
                      data-code-bg="{{ t.colors.code_bg }}"
                      data-code-fg="{{ t.colors.code_fg }}"
                      {% if t.name == "pizza-light" %}selected{% endif %}>
                {{ t.display_name }}
              </option>
              {% endfor %}
            </optgroup>
            <optgroup label="Dark Themes">
              {% for t in themes if t.variant == "dark" %}
              <option value="{{ t.name }}"
                      data-variant="{{ t.variant }}"
                      data-hljs-theme="{{ t.hljs_theme }}"
                      data-slide-bg="{{ t.colors.slide_bg }}"
                      data-slide-fg="{{ t.colors.slide_fg }}"
                      data-accent="{{ t.colors.accent }}"
                      data-code-bg="{{ t.colors.code_bg }}"
                      data-code-fg="{{ t.colors.code_fg }}">
                {{ t.display_name }}
              </option>
              {% endfor %}
            </optgroup>
          </select>
        </div>
        <button type="submit" class="build-btn">Build &amp; Download</button>
      </form>
    </div>

    <!-- Right column: preview -->
    <div class="preview-panel">
      <h3 class="preview-title">Preview</h3>
      <div class="preview-frame">
        <link id="preview-hljs-css" rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css">
        <div id="preview-slide" class="preview-slide" style="background: #FFF8F0; color: #3D2B1F;">
          <div class="preview-inner">
            <h2 style="color: #E63946;">Sample Slide</h2>
            <p>This is a preview of your slide theme.</p>
            <ul>
              <li>First point</li>
              <li>Second point</li>
              <li>Third point</li>
            </ul>
            <pre style="background: #FDEBD0; border: 2px solid rgba(61,43,31,0.15); border-radius: 8px;"><code class="language-python">def hello():
    print("Hello, hotslice!")

for i in range(3):
    hello()</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="info-section">
    <div class="info-card">
      <h3>&#9889; Quick Start</h3>
      <p>Install hotslice with a single command, then build your first deck:</p>
      <pre><code>curl -fsSL https://raw.githubusercontent.com/pid1/hotslice/main/install.sh | bash

hotslice build slides.md
open slides.html</code></pre>
      <p>Write slides in Markdown separated by <code>---</code>. Add optional TOML frontmatter for title and theme.</p>
    </div>
    <div class="info-card">
      <h3>&#127760; Web UI</h3>
      <p>Upload any <code>.md</code> file using the form above, pick a theme from the 257 available options, preview it live, and download the generated HTML.</p>
      <p>The output is a single self-contained HTML file. No dependencies, no build tools. Open it in any browser.</p>
      <p>You can also use the API directly:</p>
      <pre><code>POST /convert  (multipart form)
GET  /api/themes (JSON)</code></pre>
    </div>
    <div class="info-card">
      <h3>&#129302; MCP Server</h3>
      <p>Let AI agents build presentations for you. hotslice exposes an <a href="https://modelcontextprotocol.io" style="color: var(--primary); font-weight: 600;">MCP</a> endpoint at <code>/mcp</code> on this server.</p>
      <pre><code>{
  "mcpServers": {
    "hotslice": {
      "url": "http://HOST:PORT/mcp"
    }
  }
}</code></pre>
      <p>Tools: <code>build_presentation</code>, <code>list_themes</code>. Prompt: <code>write_presentation</code>.</p>
    </div>
  </div>

  <div class="footer">
    <div class="sponsor">
      <a href="https://github.com/sponsors/pid1" class="sponsor-link" target="_blank" rel="noopener">&#10084;&#65039; Sponsor hotslice</a>
    </div>
    Powered by <a href="https://github.com/pid1/hotslice">hotslice</a>
  </div>

  <!-- highlight.js for preview syntax highlighting -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
  <script>
  (function() {
    var select = document.getElementById('theme');
    var previewSlide = document.getElementById('preview-slide');
    var previewCss = document.getElementById('preview-hljs-css');
    var fileInput = document.getElementById('file');
    var fileLabel = document.getElementById('file-label-text');
    var searchInput = document.getElementById('theme-search');

    // File label update
    fileInput.addEventListener('change', function() {
      fileLabel.textContent = this.files.length > 0 ? this.files[0].name : 'Choose a file...';
    });

    // Theme search/filter
    searchInput.addEventListener('input', function() {
      var query = this.value.toLowerCase();
      var options = select.querySelectorAll('option');
      options.forEach(function(opt) {
        var match = opt.textContent.toLowerCase().indexOf(query) !== -1;
        opt.style.display = match ? '' : 'none';
      });
      // Show/hide optgroups based on whether they have visible options
      select.querySelectorAll('optgroup').forEach(function(group) {
        var visibleOptions = group.querySelectorAll('option:not([style*="display: none"])');
        group.style.display = visibleOptions.length > 0 ? '' : 'none';
      });
    });

    // Apply theme preview
    function applyPreview() {
      var option = select.options[select.selectedIndex];
      if (!option) return;

      var hljsSlug = option.getAttribute('data-hljs-theme') || 'github';
      var slideBg = option.getAttribute('data-slide-bg') || '#ffffff';
      var slideFg = option.getAttribute('data-slide-fg') || '#111111';
      var accent = option.getAttribute('data-accent') || '#4f46e5';
      var codeBg = option.getAttribute('data-code-bg') || '#f3f4f6';
      var codeFg = option.getAttribute('data-code-fg') || '#1f2937';

      // Apply colors to preview
      previewSlide.style.background = slideBg;
      previewSlide.style.color = slideFg;
      previewSlide.style.setProperty('--preview-accent', accent);

      var h2 = previewSlide.querySelector('h2');
      if (h2) h2.style.color = accent;

      var pre = previewSlide.querySelector('pre');
      if (pre) {
        pre.style.background = codeBg;
        pre.style.borderColor = slideFg + '26'; // 15% opacity
      }

      var code = previewSlide.querySelector('pre code');
      if (code) code.style.color = codeFg;

      // Swap hljs stylesheet
      // Base16 themes live under a base16/ subdirectory on the CDN
      var cssPath = hljsSlug;
      if (hljsSlug.indexOf('base16-') === 0) {
        cssPath = 'base16/' + hljsSlug.substring(7);
      }
      previewCss.href = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/' + cssPath + '.min.css';

      // Re-highlight code after CSS loads
      previewCss.onload = function() {
        document.querySelectorAll('#preview-slide pre code').forEach(function(block) {
          delete block.dataset.highlighted;
          hljs.highlightElement(block);
        });
      };
    }

    select.addEventListener('change', applyPreview);

    // Initial highlight
    hljs.highlightAll();
  })();
  </script>
</body>
</html>
