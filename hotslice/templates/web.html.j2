<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>hotslice - Markdown to Slides</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#x1F355;</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Comic+Neue:wght@400;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #FFF8F0;
      --fg: #3D2B1F;
      --primary: #E63946;
      --secondary: #F4A261;
      --surface: #FFFDF7;
      --accent-bg: #FDEBD0;
      --font-display: 'Fredoka', sans-serif;
      --font-body: 'Comic Neue', cursive, sans-serif;
    }

    html, body {
      height: 100%;
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--fg);
    }

    body {
      position: relative;
      overflow-x: hidden;
      min-height: 100vh;
      /* Checkered tablecloth pattern */
      background-image:
        linear-gradient(45deg, rgba(230, 57, 70, 0.04) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(230, 57, 70, 0.04) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgba(230, 57, 70, 0.04) 75%),
        linear-gradient(-45deg, transparent 75%, rgba(230, 57, 70, 0.04) 75%);
      background-size: 40px 40px;
      background-position: 0 0, 0 20px, 20px -20px, -20px 0px;
    }

    /* Floating pizza decorations */
    .floating-pizza {
      position: fixed;
      font-size: 2rem;
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
      animation: floatPizza 6s ease-in-out infinite;
    }
    .floating-pizza:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; font-size: 2.5rem; }
    .floating-pizza:nth-child(2) { top: 30%; right: 8%; animation-delay: 1.5s; font-size: 1.8rem; }
    .floating-pizza:nth-child(3) { bottom: 20%; left: 10%; animation-delay: 3s; font-size: 2.2rem; }
    .floating-pizza:nth-child(4) { bottom: 10%; right: 12%; animation-delay: 4.5s; font-size: 1.5rem; }
    .floating-pizza:nth-child(5) { top: 60%; left: 3%; animation-delay: 2s; font-size: 1.6rem; }

    @keyframes floatPizza {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(10deg); }
    }

    /* Header */
    .header {
      text-align: center;
      padding: 40px 20px 20px;
      position: relative;
      z-index: 1;
    }
    .header h1 {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 700;
      color: var(--primary);
      text-shadow: 3px 3px 0px rgba(244, 162, 97, 0.3);
      margin-bottom: 0.25rem;
    }
    .header .subtitle {
      font-family: var(--font-body);
      color: #8B7355;
      font-size: 1.1rem;
    }

    /* Main two-column layout */
    .main-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 900px) {
      .main-content {
        grid-template-columns: 1fr;
      }
    }

    /* Form card */
    .form-card {
      background: var(--surface);
      border: 3px solid var(--secondary);
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 6px 6px 0px var(--secondary);
    }
    .form-card h2 {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: var(--primary);
      margin-bottom: 1.5rem;
    }

    /* Field groups */
    .field {
      margin-bottom: 1.5rem;
    }
    .field label {
      display: block;
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 0.9rem;
      color: #6B5B4F;
      margin-bottom: 0.5rem;
    }

    /* File input styled as button */
    .file-input-wrapper {
      position: relative;
    }
    .file-input-wrapper input[type="file"] {
      position: absolute;
      width: 0;
      height: 0;
      opacity: 0;
      overflow: hidden;
    }
    .file-label {
      display: block;
      width: 100%;
      padding: 14px 25px;
      background: var(--primary);
      color: #fff;
      text-align: center;
      border-radius: 30px;
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      border: 3px solid #C0392B;
      box-shadow: 3px 3px 0px #C0392B;
      letter-spacing: 0.5px;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .file-label:hover {
      background: #C0392B;
      transform: scale(1.05) rotate(-0.5deg);
      box-shadow: 4px 5px 0px #962D22;
    }

    /* Theme select */
    .theme-select {
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      border: 3px solid var(--secondary);
      background: var(--surface);
      color: var(--fg);
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 500;
      box-shadow: 3px 3px 0px var(--secondary);
      appearance: auto;
    }
    .theme-select:focus {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    /* Build button */
    .build-btn {
      display: block;
      width: 100%;
      padding: 14px 25px;
      background: var(--primary);
      color: #fff;
      text-align: center;
      border-radius: 30px;
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      border: 3px solid #C0392B;
      box-shadow: 3px 3px 0px #C0392B;
      letter-spacing: 0.5px;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .build-btn:hover {
      background: #C0392B;
      transform: scale(1.05) rotate(-0.5deg);
      box-shadow: 4px 5px 0px #962D22;
    }

    /* Preview panel */
    .preview-panel {
      position: relative;
    }
    .preview-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: var(--primary);
      margin-bottom: 1rem;
    }
    .preview-frame {
      background: var(--surface);
      border: 3px solid var(--secondary);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 6px 6px 0px var(--secondary);
      aspect-ratio: 16 / 10;
    }
    .preview-slide {
      height: 100%;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    .preview-inner {
      overflow: hidden;
    }
    .preview-inner h2 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      margin-bottom: 0.4em;
    }
    .preview-inner p {
      font-size: 0.75rem;
      line-height: 1.5;
      margin-bottom: 0.5em;
    }
    .preview-inner ul {
      font-size: 0.75rem;
      line-height: 1.5;
      margin-left: 1.2em;
      margin-bottom: 0.5em;
    }
    .preview-inner li {
      margin-bottom: 0.15em;
    }
    .preview-inner pre {
      padding: 0.6em 0.8em;
      margin: 0.4em 0;
      overflow: hidden;
    }
    .preview-inner pre code {
      font-size: 0.65rem;
      line-height: 1.4;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    }

    /* Scoped pizza-light styles for preview */
    .preview-light {
      background: #FFF8F0;
      color: #3D2B1F;
    }
    .preview-light h2 { color: #E63946; }
    .preview-light h3 { color: #F4A261; }
    .preview-light pre { background: #FDEBD0; border: 2px solid #F4A261; border-radius: 8px; }
    .preview-light li::marker { color: #F4A261; }
    .preview-light a { color: #E63946; }

    /* Scoped pizza-dark styles for preview */
    .preview-dark {
      background: #1A0F0A;
      color: #FFF8F0;
    }
    .preview-dark h2 { color: #F4A261; }
    .preview-dark h3 { color: #E63946; }
    .preview-dark pre { background: #2D1810; border: 2px solid #3D2B1F; border-radius: 8px; }
    .preview-dark li::marker { color: #E63946; }
    .preview-dark a { color: #F4A261; }

    /* Footer */
    .footer {
      text-align: center;
      padding: 20px;
      font-family: var(--font-display);
      color: #8B7355;
      font-size: 0.85rem;
      position: relative;
      z-index: 1;
    }
    .footer a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }
    .footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <!-- Floating pizza decorations -->
  <div class="floating-pizza">&#127829;</div>
  <div class="floating-pizza">&#127830;</div>
  <div class="floating-pizza">&#127829;</div>
  <div class="floating-pizza">&#127830;</div>
  <div class="floating-pizza">&#127829;</div>

  <div class="header">
    <h1>&#127829; hotslice</h1>
    <p class="subtitle">Upload a Markdown file. Download a presentation.</p>
  </div>

  <div class="main-content">
    <!-- Left column: form -->
    <div class="form-card">
      <h2>Build Your Deck</h2>
      <form action="/convert" method="post" enctype="multipart/form-data">
        <div class="field">
          <label for="file">Markdown File</label>
          <div class="file-input-wrapper">
            <input type="file" id="file" name="file" accept=".md,.markdown,.txt" required>
            <label for="file" class="file-label" id="file-label">
              <span id="file-label-text">Choose a file...</span>
            </label>
          </div>
        </div>
        <div class="field">
          <label for="theme">Theme</label>
          <select id="theme" name="theme" class="theme-select">
            {% for t in themes %}
            <option value="{{ t.name }}"
                    data-variant="{{ t.variant }}"
                    data-hljs-theme="{{ t.hljs_theme }}"
                    {% if t.name == "pizza-light" %}selected{% endif %}>
              {{ t.display_name }}
            </option>
            {% endfor %}
          </select>
        </div>
        <button type="submit" class="build-btn">Build &amp; Download</button>
      </form>
    </div>

    <!-- Right column: preview -->
    <div class="preview-panel">
      <h3 class="preview-title">Preview</h3>
      <div class="preview-frame">
        <link id="preview-hljs-css" rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css">
        <div id="preview-slide" class="preview-slide preview-light">
          <div class="preview-inner">
            <h2>Sample Slide</h2>
            <p>This is a preview of your slide theme.</p>
            <ul>
              <li>First point</li>
              <li>Second point</li>
              <li>Third point</li>
            </ul>
            <pre><code class="language-python">def hello():
    print("Hello, hotslice!")

for i in range(3):
    hello()</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer">Powered by <a href="https://github.com/pid1/hotslice">hotslice</a></div>

  <!-- highlight.js for preview syntax highlighting -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
  <script>
  (function() {
    var select = document.getElementById('theme');
    var previewSlide = document.getElementById('preview-slide');
    var previewCss = document.getElementById('preview-hljs-css');
    var fileInput = document.getElementById('file');
    var fileLabel = document.getElementById('file-label-text');

    // Update file label when file is selected
    fileInput.addEventListener('change', function() {
      if (this.files.length > 0) {
        fileLabel.textContent = this.files[0].name;
      } else {
        fileLabel.textContent = 'Choose a file...';
      }
    });

    // Update preview when theme changes
    select.addEventListener('change', function() {
      var option = select.options[select.selectedIndex];
      var variant = option.getAttribute('data-variant');
      // Read hljs theme from data attribute
      var hljsSlug = option.getAttribute('data-hljs-theme') || 'github';

      // Update hljs stylesheet
      previewCss.href = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/' + hljsSlug + '.min.css';

      // Toggle light/dark preview class
      previewSlide.className = 'preview-slide ' + (variant === 'dark' ? 'preview-dark' : 'preview-light');

      // Re-highlight code after CSS loads
      previewCss.onload = function() {
        document.querySelectorAll('#preview-slide pre code').forEach(function(block) {
          hljs.highlightElement(block);
        });
      };
    });

    // Initial highlight
    hljs.highlightAll();
  })();
  </script>
</body>
</html>
